# PostgreSQL 설정 (로컬 또는 Supabase 이외 환경용)
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chatbot:chatbot@postgres:5432/chatbot
CRAWLER_DATABASE_URL=postgresql://chatbot:chatbot@postgres:5432/chatbot
CRAWLER_ALLOW_INSECURE_SSL=0
# HWP 등 needs_review 첨부파일 청크를 임베딩에 포함할지 여부 (1=허용, 0=차단)
CRAWLER_ALLOW_NEEDS_REVIEW_ATTACHMENT_CHUNKS=0

OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_TOKENS=512
# 고정 seed로 동일 질의의 rewrite·답변 분산 제거(재현성). 변경 가능.
OPENAI_SEED=42
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLAMA_MODEL=llama3.2:3b
LLAMA_TIMEOUT_SECONDS=90
LLAMA_NUM_PREDICT=256
EMBEDDING_MODEL=nlpai-lab/KoE5

# Cross-encoder 재랭킹 신호 (Tier 3) — 의미 불일치 케이스 보정용. 기본 off.
# A/B로 개선이 입증되기 전까지 비활성 유지(결정적 베이스라인 보존).
RAG_CROSS_ENCODER_ENABLED=0
RAG_CROSS_ENCODER_MODEL=Dongjin-kr/ko-reranker
RAG_CROSS_ENCODER_WEIGHT=1.5
RAG_CROSS_ENCODER_TOP_N=20

# Hybrid retrieval fusion: weighted | max | rrf | srrf
# 골드셋 비교(hybrid 강제) 결과 srrf가 Top-1/Context Hit 최고 → 기본값 채택
HYBRID_SCORE_MODE=srrf
HYBRID_SRRF_BETA=20
HYBRID_LEXICAL_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.45

RAG_LOG_BRANCH_CANDIDATES=0
RAG_MAX_FALLBACK_ATTEMPTS=1
RAG_FALLBACK_ORDER=vector_only_retry,original_query_no_rewrite,relaxed_filters
RAG_VECTOR_ONLY_FAMILIES=department_curriculum,building_location,welfare_facility,campus_address,person_title,course_registration,academic_schedule,seasonal_course_registration,specific_scholarship,graduation,certificate,scholarship,career
RAG_DISABLE_FALLBACK_FOR_MODES=vector

# 기본 검색 경로: LLM 단일 Query Rewrite 1회 → 그 결과로 단일 hybrid(lexical+vector srrf)
RAG_SINGLE_QUERY_REWRITE_ENABLED=1   # 0/false면 원질의 그대로 단일 검색(LLM 호출 없음)

# LLM Multi-Query(opt-in): 원질의를 LLM으로 다중 재표현 → 질의별 병렬 검색 → RRF 융합.
# 기본 OFF. 켜면 4× fan-out 비용이 들지만 Layer-2 RRF에 quality_score 분리가 적용돼
# (reciprocal_rank_fusion) quality gate는 깨지지 않는다.
RAG_MULTI_QUERY_ENABLED=0        # 기능 on/off (기본 OFF → 단일 rewrite 경로)
RAG_MULTI_QUERY_NUM=3            # LLM이 생성할 추가 재표현 수(원질의 별도 → 총 N+1 검색)
RAG_MULTI_QUERY_RRF_K=60         # Reciprocal Rank Fusion 상수
RAG_MULTI_QUERY_MAX_WORKERS=4    # 병렬 검색 워커 수
